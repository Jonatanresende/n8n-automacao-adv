        "jsCode": "// Texto original, capturado no instante do evento (sem consulta a histórico)\nconst mensagem = ($('When Executed by Another Workflow').first().json.mensagem_lead || '').toLowerCase();\n\n// Gatilhos ativos cadastrados\nconst gatilhos = $input.all().map(item => item.json);\n\nconst encontrado = gatilhos.find(g =>\n  mensagem.includes((g.trecho_chave || '').toLowerCase())\n);\n\nreturn [{\n  json: {\n    categoria: encontrado ? encontrado.categoria : null,\n  },\n  pairedItem: { item: 0 }\n}];"
      },
